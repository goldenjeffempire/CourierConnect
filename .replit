modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web"

[[workflows.workflow]]
name = "web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c \"npm run build:css && python manage.py collectstatic --noinput && gunicorn courier.wsgi:application --bind 0.0.0.0:5000 --workers 2 --timeout 120\""
waitForPort = 5000

[[workflows.workflow]]
name = "Deploy to Production"
author = 49503360
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python manage.py collectstatic --noinput"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python manage.py migrate --noinput"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "daphne -b 0.0.0.0 -p 5000 courier.asgi:application"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 45565
externalPort = 3001

[deployment]
run = ["sh", "-c", "daphne -b 0.0.0.0 -p $PORT courier.asgi:application"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]
